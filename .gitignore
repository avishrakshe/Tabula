# dependencies
node_modules/
.pnpm-store/

# secrets — never commit
.env
.env.*
!.env.example
keys/
keys/*.json
*.keypair.json
id.json

# build output
.next/
dist/
out/
build/
target/
.turbo/
coverage/
*.tsbuildinfo
next-env.d.ts

# local data (ledger DB, setup state); anchored so src/lib/data/ stays tracked
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# detect-gpu benchmark tables, copied into the site at build time
apps/web/public/gpu/

# vendored upstream sources cloned for reading (see docs/FACTS.md)
.vendor/

# os / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.log
npm-debug.log*
pnpm-debug.log*

# vercel (its .env.local is covered by .env.* above)
.vercel
