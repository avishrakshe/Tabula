# Copy to .env and adjust. Never commit .env.

# Cluster: sandbox (hosted Solana Payment Sandbox, default), localnet (local surfpool) or devnet.
TABULA_CLUSTER=sandbox
# Optional RPC override. Do not commit RPC URLs that embed API keys.
TABULA_RPC_URL=

# Where demo keypairs are generated (gitignored). Defaults to <repo>/keys.
TABULA_KEYS_DIR=

# ---- Deployment (DEPLOY.md). Names only; set real values in .env locally and with `vercel env add`. ----
# Supabase: the project URL and the public (anon / publishable) key are read-only through RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC_: the service role (secret) key and the database URLs.
SUPABASE_SERVICE_ROLE_KEY=
# Transaction-mode pooler (port 6543), for the app. Postgres-js needs prepare: false with it.
DATABASE_URL=
# Direct connection, for migrations only.
DIRECT_URL=
# Server only: the devnet RPC, plus the gateway's voucher key, generated fresh for deployment (base58).
SOLANA_RPC_URL=
TABULA_GATEWAY_SECRET_KEY=
# Checked by /api/cron/*; pg_cron sends it as a bearer token (stored in Supabase Vault).
CRON_SECRET=
DEMO_RUN_LOCK_SECONDS=120
# Public: the final site URL (absolute links, social cards, cron targets).
NEXT_PUBLIC_SITE_URL=
