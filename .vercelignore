# The Vercel CLI uploads the working directory and does not read .gitignore: never ship secrets or local state.
# Anchored with a leading slash: an unanchored data/ would also drop apps/web/src/lib/data/.
/keys/
/data/
.env
.env.*
!.env.example
*.keypair.json
id.json
*.sqlite
*.sqlite-*
*.db

# build output and caches (Vercel builds from source)
node_modules/
.next/
dist/
coverage/
.turbo/
*.tsbuildinfo
apps/web/public/gpu/

# reading material, not part of the build
.vendor/
